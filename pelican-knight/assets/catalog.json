  "policy": {
    "status": "按用户要求优化现有造型，r2 待用户确认；历史素材保留原样",
    "identity": "id 与 runtimeKey 不改名、不复用；外观变化递增条目 revision 并记录修改编号",
    "edit": "改 canonical 源后运行 python3 tools/sync_assets.py；游戏入口生成区与图鉴不直接改",
    "reference": "需要新姿态、地图、敌潮、装备组合时优先实例化现有资产。重新设计轮廓须由用户明确提出；日常数值调整不自动改外形。"
  },
  "styleGuide": {
    "palette": {
      "outline": "#426558",
      "body": "#fff9e6",
      "sage": "#8faa91",
      "coral": "#d88a65",
      "wood": "#b89c6c",
      "metal": "#78988a",
      "magic": "#75b5a5",
      "brass": "#dfb466"
    },
    "line": "圆头圆角的闭合轮廓；角色/装备外轮廓约 1.5—2 SVG 单位，建筑约 2—3；内部线条较细。按实际展示尺寸保留识别细节，避免过密装饰。",
    "perspective": "鹈鹕、武器和车辆朝右侧面；NPC与建筑为正面插画；怪物保留原朝向，补足羽毛、尖刺、关节与壳体结构。",
    "units": "游戏 SVG 设计单位。卡片 viewBox 仅负责展示，不作为碰撞尺寸。人物(0,0)为地面脚点，Y向下、z向上。",
    "layers": [
      "地面影子",
      "车辆",
      "腿",
      "躯干",
      "围巾",
      "帽子",
      "手持武器",
      "前臂"
    ],
    "rules": [
      "人物与装备分层；不为换装复制整个人物",
      "精英蟹与普通蟹有明确变体关系，居民在建筑和对话中共享",
      "卡片仅列实际存在的姿态；缺失姿态标待设计，不能凭说明宣称帧动画齐全",
      "历史卡不自动接入当前玩法；海贝货币无独立图形，不虚构图标",
      "上喙和喉囊为相接的闭合形状，嘴根在眼睛前下方，不从眼睛引线",
      "用单层阴影与少量高光区分羽毛、木、金属、织物；不增加光晕或写实纹理",
      "围巾动画只改变 tail 图层变换，轮廓与纹样由资产源保持",
      "轮廓改变只影响图形；碰撞、伤害、价格、存档 ID 不随美术调整"
    ]
  },
